{
  "_comment": "E2E scenario catalog. Edit by hand together with ux-flows/*.md and tests/*.spec.js (see CLAUDE.md). Each scenario's nodes are '<flow prefix>:<node id>' in ux-flows.",
  "_priority_rules": {
    "_how_to_apply": "A scenario is 'core' if at least one core rule applies; otherwise it is 'secondary'. Record the deciding rule in 'rule' (the core rule wins when several apply).",
    "core": {
      "C1": "Page availability - every page and main section loads without error.",
      "C2": "Search / data correctness - searches and lists return exactly the matching records.",
      "C3": "Grounded answers - the assistant answers only from the User Guide and links to it.",
      "C4": "AI safety & guard rails - generated filters are validated, out-of-scope questions are refused.",
      "C5": "Failure handling on core paths - backend or LLM failure shows a recoverable message."
    },
    "secondary": {
      "S1": "In-page UI behaviour - tabs, chips, pagination, open / close.",
      "S2": "Informational content - counts, badges, disclaimers, placeholders.",
      "S3": "Viewport / accessibility variant - mobile layout, keyboard only, screen reader.",
      "S4": "Negative / edge input - blank, too long, invalid values.",
      "S5": "Shortcut / URL state - deep links, back / forward, reload restore."
    }
  },
  "accounts": {
    "_note": "No login. These are test contexts, not user accounts.",
    "anonymous": "Desktop Chrome, local stack with LLM_MODE=stub",
    "anonymous_mobile": "Mobile viewport (Pixel 7)",
    "llm_down": "Desktop, AI endpoints answer 502 / 503 (Playwright route interception)",
    "api_down": "Desktop, data endpoints answer 500 (Playwright route interception)",
    "anonymous_ko_browser": "Desktop, browser language ko-KR, no saved choice"
  },
